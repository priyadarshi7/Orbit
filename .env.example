# Copy to .env and fill in. Never commit .env.
# You need: one LLM provider key (or a local server) and one search key (Tavily or Exa).

# ── Search ───────────────────────────────────────────────────────────────
# Either key works; with both, the other one becomes an automatic failover.
# https://tavily.com  (free tier is enough)
TAVILY_API_KEY=
# https://dashboard.exa.ai/api-keys  (free monthly credit, no card)
EXA_API_KEY=
# Primary backend: tavily | exa. Pick by benchmark: npm run bench -- --search exa  (and tavily)
SEARCH_PROVIDER=tavily

# ── LLM providers (direct, via the Vercel AI SDK) ────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Local model served over an OpenAI-compatible API.
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local

# ── Model roles ──────────────────────────────────────────────────────────
# Format: provider:model-id   (providers: groq | google | local)
# The answer model is chosen by `npm run bench`, not by taste. These are
# starting points; run `npm run models` to list the ids your keys can use.
ANSWER_MODEL=google:gemini-3.1-flash-lite
# Optional: used if the answer model errors before producing any text
# (rate limit, outage). Leave empty to disable.
ANSWER_MODEL_FALLBACK=google:gemini-2.5-flash
# Cheap model for the async memory writer and history compaction.
BACKGROUND_MODEL=google:gemini-2.5-flash
# Used only by `npm run eval -- --judge`. Should differ from the answer model.
JUDGE_MODEL=google:gemini-2.5-flash

# Optional: show an estimated cost per answer. USD per 1M tokens, keyed by model spec. Leave empty to show tokens only.
# MODEL_PRICES={"groq:openai/gpt-oss-120b":{"in":0.15,"out":0.6}}
MODEL_PRICES=

# ── Speed levers (both off by default; benchmark before enabling) ───────
# Reasoning effort for the answer model: low | medium | high. Lower is faster.
ANSWER_REASONING=
# 1 = for time-sensitive questions, search once BEFORE the first model call (saves a model round trip).
SPECULATIVE_SEARCH=

# ── Server ───────────────────────────────────────────────────────────────
# API port. The web UI is a separate Vite app on :5173 and proxies /api here.
PORT=8000
# Browser origins allowed to call the API directly (comma separated).
WEB_ORIGIN=http://localhost:5173,http://localhost:4173
# SQLite file for memory, chat history, outbox and search cache.
DB_PATH=data/orbit.db
# Default timezone when the browser does not send one (IANA name).
DEFAULT_TZ=UTC

# ── Agent budgets (hard caps enforced in code, not in the prompt) ────────
MAX_SEARCH_ROUNDS=4
MAX_QUERIES_PER_ROUND=4
# Evidence tokens added per search call, and the cap across all calls in one turn.
# Free tiers have tight tokens-per-minute limits (Groq: 8000 on some models), so keep these modest;
# raise them for models with large limits. MAX_OUTPUT_TOKENS also counts toward those limits.
EVIDENCE_TOKEN_BUDGET=2000
TURN_EVIDENCE_BUDGET=3500
# Tokens of earlier chat sent word-for-word each turn (the newest exchange is always kept in full).
HISTORY_TOKEN_BUDGET=1800
MAX_OUTPUT_TOKENS=1500
TURN_SOFT_DEADLINE_MS=40000

# ── Deep research path (plan → parallel researchers → synthesis → verifier)
# Model for the planner, researchers and verifier (many short calls). Defaults to BACKGROUND_MODEL.
RESEARCH_MODEL=
DEEP_MAX_SUBQUESTIONS=4
DEEP_CONCURRENCY=3
DEEP_RESEARCHER_ROUNDS=2
DEEP_RESEARCHER_TIMEOUT_MS=45000

# ── Accounts and limits
# Anonymous per-browser sessions (signed tokens). Set AUTH_REQUIRED=0 for single-user local use.
AUTH_REQUIRED=1
# HMAC key for tokens. Leave empty to generate one and keep it in the database.
AUTH_SECRET=
RATE_LIMIT_CHAT_PER_MIN=12
RATE_LIMIT_API_PER_MIN=240
RATE_LIMIT_SESSION_PER_MIN=20
MAX_CONCURRENT_TURNS=2
# A turn still running after this is aborted and its slot freed (the agent's own soft deadline is 40 s).
TURN_HARD_TIMEOUT_MS=180000
# Only set behind a reverse proxy you control; otherwise clients could spoof their IP.
TRUST_PROXY=0
